# =============================================================================
# CipherNest — environment configuration template
# Copy this file to ".env" before running docker compose. Never commit the
# real ".env" file (it is already listed in .gitignore).
# =============================================================================

# ---- Platform ----
# Host port that Nginx publishes. Change only if 8080 is already in use.
FRONTEND_PORT=8080

# ---- CN02 (Web Security / SQLi) — synthetic credentials only ----
CN02_DB_PATH=/app/data/ciphernest.db

# ---- CN04 (Forensics) — synthetic credentials only, NOT real secrets ----
CN04_SHARE_USER=investigator
CN04_SHARE_PASS=changeme_synthetic_only

# ---- CN05 (Networking) — synthetic FTP credentials embedded in the PCAP ----
CN05_FTP_USER=svc_backup
CN05_FTP_PASS=changeme_synthetic_only

# ---- Flag validation ----
# Secret salt used only if/when we move to salted hashing in Phase 9.
# Leave as-is for the base implementation (plain SHA-256 per flag).
FLAG_SALT=ciphernest_dev_salt_change_me
